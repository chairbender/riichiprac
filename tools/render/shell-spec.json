  "faceVariants": {
    "status": "Plan only for Phase 2 (2026-11-14). Not implemented, not baked, not part of the Phase 1/1b shell bake. The atlas is keyed by (shellType, faceVariant, tileFace), so a shell can host more than one pre-rasterised decal treatment instead of every shell reusing one glyph.",
    "atlasKey": "(shellType, faceVariant, tileFace)",
    "faceUpShells": {
      "shell_hand_standing": [
        "standing-front"
      ],
      "shell_flat_upright": [
        "flat-topdown"
      ],
      "shell_flat_sideways": [
        "flat-rot90"
      ]
    },
    "faceDownShells": {
      "shell_wall_horizontal": [
        "bare"
      ],
      "shell_wall_side_left": [
        "bare"
      ],
      "shell_wall_side_right": [
        "bare"
      ]
    },
    "note": "A variant id names the decal's perspective slot, not a camera angle: the Phase 1b pick fixes the angle behind the slot. A face-down wall shell is bare: it has no faceVariant glyph, so it contributes no atlas entries. A new treatment (for example a lifted/hovered hand decal or a second pond perspective) is a new faceVariant id on the same shell, never a second glyph swapped at draw time."
  },
