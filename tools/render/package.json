{
  "name": "riichiprac-render",
  "private": true,
  "version": "1.0.0",
  "description": "Offline 2.5D tile-shell and felt asset pipeline (Blender + resvg). Never bundled or shipped to the frontend.",
  "type": "module",
  "scripts": {
    "shells": "bash bake-shells.sh",
    "shells:dry": "bash bake-shells.sh --dry-run",
    "shells:bake": "bash bake-shells.sh --bake",
    "shells:verify": "bash bake-shells.sh --bake --verify-determinism",
    "shells:audition": "bash bake-shells.sh --audition",
    "check": "node scripts/check-shells.mjs",
    "check:audition": "node scripts/check-shells.mjs --audition",
    "review": "node scripts/review-shells.mjs",
    "felt": "bash bake-felt.sh",
    "rasterize": "node scripts/rasterize-face.mjs",
    "faces": "node scripts/bake-faces.mjs",
    "faces:verify": "node scripts/bake-faces.mjs --verify-determinism",
    "check:faces": "node scripts/check-faces.mjs",
    "decals": "bash bake-decals.sh --bake",
    "decals:build": "bash bake-decals.sh --build",
    "decals:spike": "bash bake-decals.sh --spike",
    "check:decals": "node scripts/check-decals.mjs",
    "decals:encode": "node scripts/encode-decals.mjs --format avif --quality 60",
    "check:decals:committed": "node scripts/check-decals.mjs --committed"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.1"
  }
}
