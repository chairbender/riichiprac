{
  "name": "riichiprac-render",
  "private": true,
  "version": "1.0.0",
  "description": "Offline 2.5D tile-shell and felt asset pipeline (Blender + resvg). Never bundled or shipped to the frontend.",
  "type": "module",
  "scripts": {
    "shells": "bash bake-shells.sh",
    "shells:dry": "bash bake-shells.sh --dry-run",
    "shells:bake": "bash bake-shells.sh --bake",
    "shells:verify": "bash bake-shells.sh --bake --verify-determinism",
    "check": "node scripts/check-shells.mjs",
    "review": "node scripts/review-shells.mjs",
    "felt": "bash bake-felt.sh",
    "rasterize": "node scripts/rasterize-face.mjs",
    "faces": "node scripts/bake-faces.mjs",
    "faces:verify": "node scripts/bake-faces.mjs --verify-determinism"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2"
  }
}
