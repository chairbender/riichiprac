{
  "version": 1,
  "purpose": "38 face glyph assets for the 2.5D rendered view. The SVGs are symbol-only: they carry no tile body, so runtime compositing draws the shell, then the glyph into the shell's faceQuad.",
  "source": {
    "repo": "https://github.com/SakaiTaka23/riichi-mahjong-tiles",
    "path": "Regular/regular",
    "commit": "f37d6cc2557498d23f13eb3e955e0e44e5c863ff",
    "variant": "regular symbol-only SVG, 300 x 400 viewBox",
    "license": "CC0 1.0 public domain (upstream README, 'All assets are in the public domain')",
    "notes": "The upstream Regular-Blank.svg is a red question mark, not an empty tile face, so it is deliberately not vendored. The blank face has no glyph asset: the atlas draws the bare shell for it."
  },
  "raster": {
    "width": 192,
    "height": 256,
    "format": "8-bit RGBA PNG",
    "background": "transparent",
    "shapeRendering": 2,
    "paint": {
      "redBase": "#b93c3c",
      "red": "#a60c0c"
    },
    "rationale": "192 x 256 is 2.8-3.1x the @2x glyph axes (61 x 84 px on upright shells, 66 x 93 px on the sideways shell), so the atlas only ever downsamples when composed at pixelRatio 2. The 300 x 400 upstream canvas is scaled uniformly to 0.64, keeping the symbol's own margins."
  },
  "output": {
    "dir": "../../frontend/public/table/faces",
    "manifest": "../../frontend/public/table/faces.json",
    "bytesBudget": 1048576
  },
  "faces": [
